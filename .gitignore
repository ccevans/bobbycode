node_modules/
coverage/
.DS_Store
*.log

# Bobby dogfoods itself: this repo is a Bobby project, so .bobby/ is tracked —
# tickets and decisions are the work record and belong in history.
# These three are per-machine or pure noise and are not:
.bobby/sessions/
.bobby/workspaces.json
.bobby/.counter.lock
.bobby/main-checkout.lock
# A LIVE claim on a ticket (BOB-120), not a fact about it. Committed, it would
# travel to other machines carrying a pid and host that mean nothing there —
# and isStale refuses to judge a foreign host, so the 6h ceiling would be the
# only thing freeing that ticket on every clone.
.bobby/tickets/*/run.lock
